# ===========================================
# AI Lead Generation Agent - Configuration
# ===========================================

# ============ API KEYS ============

# Google Maps API Key (required for lead search)
GOOGLE_MAPS_API_KEY=your-google-maps-api-key

# OpenAI API Key (optional, for AI email generation)
OPENAI_API_KEY=sk-your-openai-api-key

# Anthropic API Key (optional, alternative to OpenAI)
ANTHROPIC_API_KEY=sk-ant-your-anthropic-key


# ============ COMPANY INFO ============

SENDER_NAME=Your Name
COMPANY_NAME=Your Company Name
COMPANY_WEBSITE=https://yourcompany.com
COMPANY_PHONE=0123456789


# ============ EMAIL (SMTP) ============

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your-email@gmail.com
SMTP_PASSWORD=your-app-password
SENDER_EMAIL=your-email@gmail.com


# ============ DATABASE ============

DATABASE_URL=sqlite:///./data/leads.db


# ============ AGENT SETTINGS ============

DEFAULT_LANGUAGE=vi
MAX_LEADS_PER_SEARCH=50
EMAIL_DAILY_LIMIT=100
DELAY_BETWEEN_REQUESTS=2
USE_AI_FOR_EMAILS=true


# ============ SCHEDULER SETTINGS ============
# (Used when running run_scheduler.py)

SCHEDULE_KEYWORDS=spa,cafe,nha khoa
SCHEDULE_LOCATIONS=TP.HCM
SCHEDULE_SEARCH_ENABLED=true
SCHEDULE_SEARCH_HOURS=24
SCHEDULE_FOLLOWUP_ENABLED=true
SCHEDULE_FOLLOWUP_HOURS=8
SCHEDULE_EMAIL_ENABLED=true
SCHEDULE_EMAIL_BATCH=20
SCHEDULE_EMAIL_MINUTES=30
SUMMARY_TIME=18:00


# ============ NOTIFICATIONS ============

# Telegram (recommended!)
TELEGRAM_ENABLED=false
TELEGRAM_BOT_TOKEN=your-bot-token-from-botfather
TELEGRAM_CHAT_ID=your-chat-id

# Discord
DISCORD_ENABLED=false
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/xxx/xxx

# Daily summary notification
NOTIFY_DAILY_SUMMARY=true


# ============ N8N INTEGRATION ============
# (Only if using n8n)

N8N_WEBHOOK_URL=http://localhost:5678/webhook
N8N_API_KEY=your-n8n-api-key
