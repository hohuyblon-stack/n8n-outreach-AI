# ===========================================
# AI Lead Generation Agent - Configuration
# ===========================================

# OpenAI API Key (for email generation)
OPENAI_API_KEY=sk-your-openai-api-key

# Anthropic API Key (alternative LLM)
ANTHROPIC_API_KEY=sk-ant-your-anthropic-key

# Google Maps API Key
GOOGLE_MAPS_API_KEY=your-google-maps-api-key

# Email Configuration (for sending outreach emails)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your-email@gmail.com
SMTP_PASSWORD=your-app-password
SENDER_NAME=Your Name
SENDER_EMAIL=your-email@gmail.com

# N8N Integration
N8N_WEBHOOK_URL=http://localhost:5678/webhook
N8N_API_KEY=your-n8n-api-key

# Database
DATABASE_URL=sqlite:///./data/leads.db

# Agent Configuration
DEFAULT_LANGUAGE=vi
MAX_LEADS_PER_SEARCH=50
EMAIL_DAILY_LIMIT=100
DELAY_BETWEEN_REQUESTS=2

# Company Info (for email signature)
COMPANY_NAME=Your Company Name
COMPANY_WEBSITE=https://yourcompany.com
COMPANY_PHONE=0123456789
